{
  "name": "coast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4-canary.1+6bb5dc195",
  "engines": {
    "bun": ">=1.4.4-canary.1"
  },
  "scripts": {
    "dev": "bun run reading:native && bun --bun vite dev --host 0.0.0.0",
    "build": "bun run adapter:check && bun run navigation:check && bun --bun vite build && bun scripts/build-reading-extractor.ts build/reading-extractor",
    "start": "bun build/index.js",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test ./tests",
    "ui:inventory": "bun scripts/ui-inventory.ts",
    "ui:inventory:check": "bun scripts/ui-inventory.ts --check",
    "test:db": "bun scripts/test-database.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "test:recovery": "bun scripts/test-recovery.ts",
    "code:style": "bun scripts/source-style.ts",
    "code:inventory": "bun scripts/code-inventory.ts --check",
    "navigation:check": "bun scripts/check-navigation-runtime.ts",
    "reading:native": "bun scripts/build-reading-extractor.ts",
    "adapter:check": "bun scripts/check-bun-adapter.ts",
    "test:performance:copy": "bun scripts/performance-followup.ts",
    "test:performance:finalization": "bun scripts/performance-finalization.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/svelte": "^1.1.5",
    "@zip.js/zip.js": "^2.24.0",
    "drizzle-orm": "^0.45.4",
    "epubjs": "^0.3.93",
    "hls.js": "^1.7.3",
    "libarchive-wasm": "1.2.0",
    "pdfjs-dist": "^6.4.299",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-bun": "1.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "patchedDependencies": {
    "@sveltejs/adapter-bun@1.0.0": "patches/sveltejs-adapter-bun-1.0.0.patch",
    "@sveltejs/kit@3.1.0": "patches/sveltejs-kit-3.1.0.patch"
  }
}
